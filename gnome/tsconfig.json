{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@girs/gjs", "@girs/gjs/dom", "@girs/gnome-shell/ambient", "@girs/gnome-shell/extensions/global"],
    "rootDir": "extension",
    "outDir": "../target/extension",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": [
    "extension/extension.ts",
    "extension/src/**/*.ts",
    "extension/tests/integration/**/*.ts",
    "extension/tests/support/shell-events.ts",
    "extension/tests/support/*.d.ts"
  ],
  "exclude": []
}
